{
  "name": "dailydev-tracker",
  "displayName": "dailydev-tracker",
  "description": "Track daily tasks, project-wise working time, client support, and generate daily timesheet summaries.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dailydev-tracker.startTask",
        "title": "DailyDev: Start Task"
      },
      {
        "command": "dailydev-tracker.addProject",
        "title": "DailyDev: Add Project"
      },
      {
        "command": "dailydev-tracker.switchTask",
        "title": "DailyDev: Switch Task"
      },
      {
        "command": "dailydev-tracker.pauseTask",
        "title": "DailyDev: Pause Task"
      },
      {
        "command": "dailydev-tracker.resumeTask",
        "title": "DailyDev: Resume Task"
      },
      {
        "command": "dailydev-tracker.stopTask",
        "title": "DailyDev: Stop Task"
      },
      {
        "command": "dailydev-tracker.showActiveTaskMenu",
        "title": "DailyDev: Task Menu"
      },
      {
        "command": "dailydev-tracker.editEntryDuration",
        "title": "DailyDev: Correct Entry Duration"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/sql.js": "^1.4.11",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "sql.js": "^1.15.0"
  }
}
